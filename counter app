import React, { useState } from 'react';

function App() {
  let stock = 10;
  const [count, setCount] = useState(0);

  const styles = {
    main: {
      padding: '20px',
    },
    title: {
      color: '#5C6AC4'
    },
  };

  return (
    <div style={styles.main}>
      <h1 style={styles.title}>Hello, World!</h1>
      <div>
        <button onClick={() => {
          if (count > 0) {
            setCount(count - 1);
          }
        }}>
          -
        </button>

        <button onClick={() => {
          if (count < stock) {
            setCount(count + 1);
          }
        }}>
          +
        </button>
      </div>
    </div>
  );
}

export default App;
