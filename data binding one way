import React from 'react';
import { useState } from 'react'

function App() {
  const [count, setCount] = useState(0)
  
  const styles = {
    main: {
      padding: '20px',
    },
    title: {
      color: '#5C6AC4'
    },
  };

  return (
    <div style={styles.main}>
      <div>
        <button onClick={() => setCount(100)}>
          count {count}
        </button>
      </div>
    </div>
  )
}


export default App
