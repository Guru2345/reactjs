function App() {
  const [productname, updatedName] = useState("this is redmi 9 power");
  const [price, setPrice] = useState("");

  return (
    <>
      <h1>Product Name: {productname}</h1>

      <input
        type="text"
        placeholder="Enter price"
        value={price}
        onChange={(e) => setPrice(e.target.value)}
      />

      <br /><br />

      <button
        onClick={() => {
          updatedName((prev) => prev + " " + price);
          setPrice("");
        }}
      >
        Update
      </button>
    </>
  );
}

export default App;
