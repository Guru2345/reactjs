import React from 'react'
import PropTypes from 'prop-types';
function User(props){
  return(
    <div>
      <h1>User Component</h1>
      <p>Name: {props.name}</p>
      <p>Age: {props.age}</p>
    </div>
  );
}
User.propTypes={
  name:PropTypes.string,
  age:PropTypes.number
}
function App(){
  return(
    <div>
      <User name="John" age={30} />
    </div>
  )
}
export default App;
